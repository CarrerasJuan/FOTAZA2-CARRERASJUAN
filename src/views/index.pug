doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Fotaza
  body
    h1 Fotaza
    p Plataforma comunitaria de fotografias y videos
    p
      a(href="/posts") Ver publicaciones
    if sessionUser
      p
        a(href=`/users/${sessionUser.id}`) Ver mi perfil
      p
        a(href="/notifications") Ver notificaciones
      form(action="/auth/logout" method="POST")
        button(type="submit") Cerrar sesión
    else
      p
        a(href="/auth/login") Iniciar sesión
      p
        a(href="/auth/register") Crear cuenta
