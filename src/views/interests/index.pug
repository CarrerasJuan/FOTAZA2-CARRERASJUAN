extends ../layouts/main

block content
  section.page-section
    .panel
      span.section-eyebrow Curación personal
      h1 Mis intereses
      p.section-description Acá se listan las publicaciones que guardaste como interés para revisarlas más tarde.
      .inline-actions
        a.button.button--ghost(href="/posts") Volver a publicaciones

  section.page-section
    if interests.length
      .grid.grid--cards
        each interest in interests
          if interest.post
            article.feed-card
              .feed-card__media
                if interest.post.media && interest.post.media.length && interest.post.media[0].type === "image"
                  img(src=interest.post.media[0].url alt=interest.post.title)
              .feed-card__body
                h2.feed-card__title= interest.post.title
                p.text-muted= interest.post.user ? `Por ${interest.post.user.username}` : "Sin usuario"
                a.button.button--ghost.button--small(href=`/posts/${interest.post.id}`) Ver publicación
    else
      .empty-state
        p Todavía no guardaste publicaciones en intereses.
