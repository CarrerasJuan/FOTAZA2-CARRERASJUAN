doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1 Mis intereses

    if interests.length
      each interest in interests
        if interest.post
          article
            h2= interest.post.title
            p Autor: #{interest.post.user ? interest.post.user.username : "Sin usuario"}
            p
              a(href=`/posts/${interest.post.id}`) Ver publicación
            if interest.post.media && interest.post.media.length
              each item in interest.post.media
                if item.type === "image"
                  img(src=item.url alt=interest.post.title width="220")
    else
      p Todavía no guardaste publicaciones en intereses.

    p
      a(href="/posts") Volver a publicaciones
