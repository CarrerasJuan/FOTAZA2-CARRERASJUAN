extends ../layouts/main

block content
  if profileUser
    section.page-section
      .profile-card
        .profile-card__avatar
          if profileUser.avatar_url
            img(src=profileUser.avatar_url alt=profileUser.username)
          else
            span= profileUser.username ? profileUser.username.charAt(0).toUpperCase() : "U"
        .profile-card__body
          span.section-eyebrow Perfil de usuario
          h1.profile-card__name= profileUser.username
          .profile-meta
            span= profileUser.email
            span= `Estado: ${profileUser.status}`
            span= `Miembro desde: ${profileUser.created_at}`
          if profileUser.biography
            p.section-description= profileUser.biography
          .profile-stats
            .profile-stat
              strong= followSummary ? followSummary.followersCount : 0
              p.text-muted Seguidores
            .profile-stat
              strong= followSummary ? followSummary.followingCount : 0
              p.text-muted Seguidos
            .profile-stat
              strong= profileUser.posts ? profileUser.posts.length : 0
              p.text-muted Publicaciones
          .inline-actions
            if sessionUser && sessionUser.id === profileUser.id
              a.button.button--dark(href=`/users/${profileUser.id}/edit`) Editar perfil
              a.button.button--ghost(href="/interests") Ver mis intereses
            else if sessionUser && sessionUser.id !== profileUser.id
              if followSummary && followSummary.isFollowing
                form(action=`/users/${profileUser.id}/unfollow` method="POST")
                  button.button.button--ghost(type="submit") Dejar de seguir
              else
                form(action=`/users/${profileUser.id}/follow` method="POST")
                  button.button.button--dark(type="submit") Seguir
            a.button.button--soft(href="/posts") Volver a publicaciones

    section.page-section
      .panel
        h2 Publicaciones del usuario
        if profileUser.posts && profileUser.posts.length
          .grid.grid--cards
            each post in profileUser.posts
              article.feed-card
                .feed-card__media
                  if post.media && post.media.length && post.media[0].type === "image"
                    img(src=post.media[0].url alt=post.title)
                .feed-card__body
                  h3.feed-card__title= post.title
                  if post.description
                    p.text-muted= post.description
                  a.button.button--ghost.button--small(href=`/posts/${post.id}`) Ver publicación
        else
          .empty-state
            p Este usuario todavía no tiene publicaciones registradas.
  else
    .empty-state
      h1 Usuario no encontrado
      p.text-muted No existe un usuario registrado con el identificador solicitado.
      a.button.button--ghost(href="/posts") Volver a publicaciones
