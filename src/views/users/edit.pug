extends ../layouts/main

block content
  section.page-section.form-shell
    .panel
      span.section-eyebrow Perfil
      h1 Editar perfil
      p.section-description Actualizá los datos visibles de tu cuenta manteniendo el mismo flujo de autenticación.

      if error
        .alert= error

      form.form-grid(action=`/users/${profileUser.id}/edit` method="POST" enctype="multipart/form-data")
        .form-field
          label(for="username") Usuario
          input#username.form-input(type="text" name="username" required maxlength="50" value=values.username)

        .form-field
          label(for="email") Correo
          input#email.form-input(type="email" name="email" required maxlength="100" value=values.email)

        .form-field
          label(for="biography") Biografía
          textarea#biography.form-textarea(name="biography")= values.biography

        .form-field
          label(for="avatar_file") Avatar desde archivo
          input#avatar_file.form-input(type="file" name="avatar_file" accept="image/jpeg,image/png,image/webp")
          small.form-hint O subí una URL:

        .form-field
          label(for="avatar_url") URL de avatar
          input#avatar_url.form-input(type="url" name="avatar_url" maxlength="255" value=values.avatar_url placeholder="Opcional si subiste un archivo")

        .inline-actions
          button.button.button--dark(type="submit") Guardar cambios
          a.button.button--ghost(href=`/users/${profileUser.id}`) Volver al perfil
