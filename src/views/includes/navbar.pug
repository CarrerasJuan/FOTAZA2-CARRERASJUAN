mixin navLink(href, label)
  a.navbar__link(href=href)= label

header.navbar
  .navbar__inner
    .navbar__brand-group
      a.navbar__brand(href="/")
        span.navbar__brand-mark F
        span.navbar__brand-text Fotaza

    nav.navbar__links.navbar__links--desktop
      +navLink("/", "Descubrir")
      +navLink("/posts", "Publicaciones")
      +navLink("/collections", "Colecciones")
      +navLink("/interests", "Intereses")

    form.navbar__search(action="/search" method="GET")
      span.navbar__search-icon(aria-hidden="true") ⌕
      label.sr-only(for="navbar-search") Buscar
      input#navbar-search.navbar__search-input(
        type="text"
        name="q"
        placeholder="Buscar publicaciones, usuarios o tags"
        value=typeof query !== "undefined" ? query : ""
      )
      button.button.button--ghost.navbar__search-button(type="submit") Buscar

    .navbar__actions
      if sessionUser
        details.navbar__account
          summary.navbar__account-toggle
            span.navbar__account-avatar= sessionUser.username ? sessionUser.username.charAt(0).toUpperCase() : "U"
          .navbar__account-menu
            if sessionUser.email
              p.navbar__account-email= sessionUser.email
            a.navbar__account-link(href=`/users/${sessionUser.id}`) Mi perfil
            a.navbar__account-link(href="/interests") Mis intereses
            a.navbar__account-link(href="/posts/following") Seguidos
            a.navbar__account-link(href="/notifications")
              | Notificaciones
              if typeof unreadNotifications !== "undefined" && unreadNotifications > 0
                span.navbar__badge= unreadNotifications
            if sessionUser.role === "validator"
              a.navbar__account-link(href="/validator") Validador
            form.navbar__account-logout(action="/auth/logout" method="POST")
              button.navbar__account-link.navbar__account-link--button(type="submit") Cerrar sesión
      else
        .navbar__cta
          a.button.button--ghost.button--small(href="/auth/register") Registrarse
          a.button.button--dark.button--small(href="/auth/login") Iniciar sesión
