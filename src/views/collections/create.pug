extends ../layouts/main

block content
  section.page-section.form-shell
    .panel
      span.section-eyebrow Nueva colección
      h1 Crear colección
      p.section-description Definí un nombre simple para organizar publicaciones guardadas.

      if error
        .alert= error

      form.form-grid(action="/collections" method="POST")
        .form-field
          label(for="name") Nombre
          input#name.form-input(type="text" name="name" required maxlength="80" value=values.name)

        .inline-actions
          button.button.button--dark(type="submit") Guardar colección
          a.button.button--ghost(href="/collections") Volver a colecciones
