doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1 Crear colección

    if error
      p= error

    form(action="/collections" method="POST")
      div
        label(for="name") Nombre
        input#name(type="text" name="name" required maxlength="80" value=values.name)

      button(type="submit") Guardar colección

    p
      a(href="/collections") Volver a colecciones
