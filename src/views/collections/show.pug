extends ../layouts/main

block content
  if collection
    section.page-section
      .panel
        span.section-eyebrow Colección
        h1= collection.name
        p.section-description= collection.user ? `Propietario: ${collection.user.username}` : "Colección personal"
        .inline-actions
          a.button.button--ghost(href="/collections") Volver a colecciones
          a.button.button--soft(href="/posts") Explorar publicaciones

    section.page-section
      if collection.items && collection.items.length
        .grid.grid--cards
          each item in collection.items
            if item.post
              article.collection-card
                .collection-card__media
                  if item.post.media && item.post.media.length && item.post.media[0].type === "image"
                    img(src=item.post.media[0].url alt=item.post.title)
                .collection-card__body
                  h3.collection-card__title= item.post.title
                  p.text-muted= item.post.user ? `Por ${item.post.user.username}` : "Sin usuario"
                  if item.post.description
                    p.text-muted= item.post.description
                  a.button.button--ghost.button--small(href=`/posts/${item.post.id}`) Ver publicación
      else
        .empty-state
          p Esta colección todavía no tiene publicaciones guardadas.
  else
    .empty-state
      h1 Colección no encontrada
      p.text-muted No existe una colección registrada con el identificador solicitado.
      a.button.button--ghost(href="/collections") Volver a colecciones
