extends ../layouts/main

block content
  section.page-section
    .panel
      span.section-eyebrow Organización
      h1 Mis colecciones
      p.section-description Guardá publicaciones agrupadas en colecciones personales para consultarlas después.
      .inline-actions
        a.button.button--dark(href="/collections/create") Crear colección
        a.button.button--ghost(href="/posts") Volver a publicaciones

  section.page-section
    if collections.length
      .grid.grid--cards
        each collection in collections
          article.collection-card
            .collection-card__body
              h2.collection-card__title= collection.name
              p.text-muted= `Elementos guardados: ${collection.items ? collection.items.length : 0}`
              a.button.button--ghost.button--small(href=`/collections/${collection.id}`) Ver colección
    else
      .empty-state
        h2 Todavía no tienes colecciones creadas
        p.text-muted Cuando agregues publicaciones a tus colecciones, aparecerán listadas acá.
        a.button.button--dark(href="/collections/create") Crear primera colección
