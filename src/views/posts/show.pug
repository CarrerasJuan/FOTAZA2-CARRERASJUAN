extends ../layouts/main

block content
  if post
    - const technicalTags = new Set(["seedpublic", "seedrestricted", "seeddelete", "fase5c", "edit", "delete", "restricted"])
    - const normalizeTagLabel = (name) => {
    -   if (!name) return null;
    -   const lower = String(name).trim().toLowerCase();
    -   if (technicalTags.has(lower)) return null;
    -   if (lower === "public") return "Público";
    -   return name;
    - }
    - const getVisibleTags = (tags) => (tags || []).map((tag) => ({ id: tag.id, label: normalizeTagLabel(tag.name) })).filter((tag) => tag.label)
    - const normalizeSeedTitle = (sourcePost) => {
    -   const rawTitle = sourcePost && sourcePost.title ? String(sourcePost.title).trim() : "";
    -   const lower = rawTitle.toLowerCase();
    -   const isRestricted = lower.includes("restricted") || sourcePost.isMediaRestrictedForAnonymous;
    -   if (!rawTitle) return "Contenido visual";
    -   if (lower.includes("public seed")) return "Publicación pública";
    -   if (lower.includes("restricted seed")) return "Publicación restringida";
    -   if (lower.includes("disposable seed")) return "Imagen de prueba";
    -   if (lower.includes("seed") || /\b\d{6,}\b/.test(rawTitle)) {
    -     return isRestricted ? "Contenido visual restringido" : "Contenido visual";
    -   }
    -   return rawTitle;
    - }
    - const normalizeSeedDescription = (description) => {
    -   if (!description) return null;
    -   const text = String(description).trim();
    -   const lower = text.toLowerCase();
    -   if (!text) return null;
    -   if (lower.includes("seed") || lower.includes("fase5c") || lower.includes("disposable")) {
    -     return "Publicación visual disponible para explorar, valorar y compartir dentro de la comunidad.";
    -   }
    -   return text;
    - }
    - const normalizeLicense = (license) => {
    -   if (!license) return null;
    -   const lower = String(license).trim().toLowerCase();
    -   if (lower === "standard") return "Estándar";
    -   if (lower === "public-domain") return "Dominio público";
    -   if (lower === "cc-by") return "CC BY";
    -   if (lower === "cc-by-nc") return "CC BY-NC";
    -   if (lower === "copyright") return "Copyright";
    -   return license;
    - }
    - const buildStars = (value) => {
    -   const score = Math.max(0, Math.min(5, Number(value) || 0));
    -   let stars = "";
    -   for (let i = 1; i <= 5; i++) {
    -     if (score >= i) stars += "★";
    -     else if (score >= i - 0.5) stars += "<span style=\"position:relative;display:inline-block;\">☆<span style=\"position:absolute;left:0;top:0;overflow:hidden;width:50%;color:gold;\">★</span></span>";
    -     else stars += "☆";
    -   }
    -   return stars;
    - }
    - const primaryMedia = post.primaryMedia || (post.media && post.media.length ? post.media[0] : null)
    - const watermarkLabel = primaryMedia ? (primaryMedia.watermark_text || (primaryMedia.license === "copyright" ? "Copyright" : null)) : null
    - const displayTitle = normalizeSeedTitle(post)
    - const displayDescription = normalizeSeedDescription(post.description)
    - const displayTags = getVisibleTags(post.tags)
    - const displayLicense = primaryMedia ? normalizeLicense(primaryMedia.license) : null
    section.page-section.detail-grid
      article.detail-card
        .detail-card__hero
          .detail-card__hero-media
            if post.canShowPrimaryMedia && primaryMedia && primaryMedia.type === "image"
              .detail-card__media-frame
                img(src=primaryMedia.url alt=displayTitle)
                if watermarkLabel
                  .detail-card__watermark-grid(aria-hidden="true")
                    each _ in [1, 2, 3, 4, 5, 6]
                      span.detail-card__watermark= watermarkLabel
            else if post.isMediaRestrictedForAnonymous
              .media-guard.media-guard--soft.media-guard--detail
                span.media-guard__eyebrow Vista limitada
                strong Contenido restringido
                p.text-muted Disponible solo para usuarios registrados o limitado por licencia.
          .detail-card__content
            if formError
              .alert= formError
            h1.detail-card__title= displayTitle
            .detail-meta
              span= post.user ? `Por ${post.user.username}` : "Sin usuario"
              span= post.status === "active" ? "Publicación activa" : `Estado: ${post.status}`
              span= post.comments_enabled ? "Comentarios abiertos" : "Comentarios cerrados"
            if displayLicense
              .badge-row
                span.badge Licencia: #{displayLicense}
                if primaryMedia.watermark_text
                  span.badge Marca de agua: #{primaryMedia.watermark_text}
            if displayDescription
              p.section-description= displayDescription
            .badge-row
              a.badge.badge--link(href=`/users/${post.user_id}`) Ver perfil del autor
              if displayTags.length
                each tag in displayTags
                  a.badge.badge--link(href=`/posts/tags/${tag.id}`)= tag.label

            .metric-grid
              .metric
                .metric__label Promedio
                .metric__value.metric__value--stars
                  if ratingSummary && ratingSummary.average
                    - const displayAverage = Number(ratingSummary.average) % 1 === 0 ? Number(ratingSummary.average).toFixed(0) : Number(ratingSummary.average).toFixed(1)
                    - const avgValue = Number(ratingSummary.average)
                    | !{buildStars(avgValue)} #{displayAverage}
                  else
                    | Sin valoraciones todavía
              .metric
                .metric__label Valoraciones
                .metric__value= ratingSummary && ratingSummary.total ? `${ratingSummary.total} registradas` : "0 valoraciones"
              .metric
                .metric__label Denuncias
                .metric__value= typeof totalReports === "number" ? totalReports : 0

            .footer-link-row
              a.button.button--ghost(href="/posts") Volver al listado
              a.button.button--soft(href=`/search?q=${encodeURIComponent(post.title)}`) Buscar similares
              - const canManagePost = currentUserOwnsPost || (sessionUser && sessionUser.role === 'validator')
              if canManagePost
                if currentUserOwnsPost && isEditBlocked
                  span.text-muted No puedes editar esta publicación porque tiene denuncias activas.
                else if currentUserOwnsPost
                  a.button.button--dark(href=`/posts/${post.id}/edit`) Editar
                if !isEditBlocked
                  form(action=`/posts/${post.id}/delete` method="POST")
                    button.button.button--danger(type="submit") Eliminar
                else if currentUserOwnsPost
                  span.text-muted No puedes eliminar esta publicación porque tiene denuncias activas.

      aside.detail-sidebar
        .panel
          h2 Interacciones
          if sessionUser
            .stack-actions
              if currentUserOwnsPost
                p.text-muted No puedes marcar interés en tu propia publicación.
              else if currentUserInterest
                form(action=`/interests/${post.id}/delete` method="POST")
                  button.button.button--soft(type="submit") Quitar me interesa
              else
                form.form-grid(action="/interests" method="POST")
                  input(type="hidden" name="post_id" value=post.id)
                  .form-field
                    label(for="interest-message") Mensaje (opcional)
                    textarea#interest-message.form-textarea(name="message" rows="2" placeholder="Dejá un mensaje al autor...")
                  button.button.button--soft(type="submit") Me interesa

              if userCollections && userCollections.length
                form.form-grid(action=`/collections/${userCollections[0].id}/items` method="POST")
                  input(type="hidden" name="post_id" value=post.id)
                  .form-field
                    label(for="collection_id") Guardar en colección
                    select#collection_id.form-select(name="collection_id" onchange="this.form.action='/collections/' + this.value + '/items'")
                      each collection in userCollections
                        option(value=collection.id)= collection.name
                  button.button.button--ghost(type="submit") Agregar
              else
                p.text-muted No tienes colecciones creadas todavía.
                a.button.button--ghost(href="/collections/create") Crear colección

            .panel.page-section
              h3 Valoración
              if currentUserOwnsPost
                p.text-muted No puedes valorar tu propia publicación.
              else if ratingSummary && ratingSummary.currentUserRating
                p.text-muted
                  span.rating-summary__stars!= buildStars(ratingSummary.currentUserRating.points)
                  |  Ya valoraste esta publicación con #{ratingSummary.currentUserRating.points} de 5.
              else
                p.text-muted Todavía no valoraste esta publicación.
                form.form-grid(action=`/posts/${post.id}/ratings` method="POST")
                  .form-field
                    label(for="points-select") Elegí un puntaje
                    select#points-select.form-select(name="points" required)
                      option(value="" disabled selected) — Seleccionar —
                      option(value="5") 5 - Excelente
                      option(value="4.5") 4.5
                      option(value="4") 4 - Muy bueno
                      option(value="3.5") 3.5
                      option(value="3") 3 - Bueno
                      option(value="2.5") 2.5
                      option(value="2") 2 - Regular
                      option(value="1.5") 1.5
                      option(value="1") 1 - Malo
                  button.button.button--dark(type="submit") Guardar valoración

            .panel
              h3 Denunciar publicación
              if currentUserOwnsPost
                p.text-muted No puedes denunciar tu propia publicación.
              else if !currentUserCanReport
                p.text-muted Ya registraste una denuncia activa sobre esta publicación.
              else
                form.form-grid(action=`/posts/${post.id}/reports` method="POST")
                  .form-field
                    label(for="reason") Motivo
                    input#reason.form-input(type="text" name="reason" maxlength="100" required)
                  .form-field
                    label(for="description") Descripción
                    textarea#description.form-textarea(name="description")
                  button.button.button--ghost(type="submit") Enviar denuncia
          else
            p.text-muted Iniciá sesión para valorar, denunciar, guardar intereses o agregar esta publicación a una colección.
            .inline-actions
              a.button.button--dark(href="/auth/login") Iniciar sesión
              a.button.button--ghost(href="/auth/register") Crear cuenta

    section.page-section.grid.grid--two
      .panel
        h2 Comentarios
        if post.comments && post.comments.length
          .comment-list(data-comment-list)
            each comment in post.comments
              article.comment-item(data-comment-item)
                strong= comment.user ? comment.user.username : "Usuario"
                p.text-muted= comment.content ? String(comment.content).replace(/<[^>]*>/g, '') : ''
                - const canDeleteComment = sessionUser && (sessionUser.id === comment.user_id || sessionUser.id === post.user_id || sessionUser.role === 'validator')
                if canDeleteComment
                  form.comment-item__actions(action=`/posts/${post.id}/comments/${comment.id}/delete` method="POST" data-comment-delete-form)
                    input(type="hidden" name="redirect_to" value=`/posts/${post.id}`)
                    button.button.button--ghost.button--small(type="submit") Eliminar comentario
        else
          .empty-state(data-comment-empty-state)
            p No hay comentarios registrados por el momento.

      .panel
        h2 Participar
        if sessionUser && post.comments_enabled
          form.form-grid(action=`/posts/${post.id}/comments` method="POST")
            input(type="hidden" name="redirect_to" value=`/posts/${post.id}`)
            .form-field
              label(for="content") Comentario
              textarea#content.form-textarea(name="content" required)
            button.button.button--dark(type="submit") Publicar comentario
        else if sessionUser
          p.text-muted Los comentarios están deshabilitados para esta publicación.
        else
          p.text-muted Necesitás iniciar sesión para comentar.
          a.button.button--dark(href="/auth/login") Iniciar sesión
  else
    .empty-state
      h1 Publicación no encontrada
      p.text-muted No existe una publicación registrada con el identificador solicitado.
      a.button.button--ghost(href="/posts") Volver al listado
