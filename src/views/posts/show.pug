extends ../layouts/main

block content
  if post
    - const primaryMedia = post.media && post.media.length ? post.media[0] : null
    - const watermarkLabel = primaryMedia ? (primaryMedia.watermark_text || (primaryMedia.license === "copyright" ? "Copyright" : null)) : null
    section.page-section.detail-grid
      article.detail-card
        .detail-card__hero
          .detail-card__hero-media
            if primaryMedia && primaryMedia.type === "image"
              .detail-card__media-frame
                img(src=primaryMedia.url alt=post.title)
                if watermarkLabel
                  span.detail-card__watermark= watermarkLabel
          .detail-card__content
            if formError
              .alert= formError
            h1.detail-card__title= post.title
            .detail-meta
              span= post.user ? `Por ${post.user.username}` : "Sin usuario"
              span= `Estado: ${post.status}`
              span= post.comments_enabled ? "Comentarios habilitados" : "Comentarios cerrados"
            if primaryMedia && primaryMedia.license
              .badge-row
                span.badge Licencia: #{primaryMedia.license}
                if primaryMedia.watermark_text
                  span.badge Marca de agua: #{primaryMedia.watermark_text}
            if post.description
              p.section-description= post.description
            .badge-row
              a.badge.badge--link(href=`/users/${post.user_id}`) Ver perfil del autor
              if post.tags && post.tags.length
                each tag in post.tags
                  a.badge.badge--link(href=`/posts/tags/${tag.id}`)= tag.name

            .metric-grid
              .metric
                .metric__label Valoraciones
                .metric__value= ratingSummary && ratingSummary.total ? ratingSummary.total : 0
              .metric
                .metric__label Promedio
                .metric__value= ratingSummary && ratingSummary.average ? ratingSummary.average : "Sin datos"
              .metric
                .metric__label Denuncias
                .metric__value= typeof totalReports === "number" ? totalReports : 0

            .footer-link-row
              a.button.button--ghost(href="/posts") Volver al listado
              a.button.button--soft(href=`/search?q=${encodeURIComponent(post.title)}`) Buscar relacionado
              if currentUserOwnsPost
                if isEditBlocked
                  span.text-muted No puedes editar esta publicación porque tiene denuncias activas.
                else
                  a.button.button--dark(href=`/posts/${post.id}/edit`) Editar
                form(action=`/posts/${post.id}/delete` method="POST")
                  button.button.button--danger(type="submit") Eliminar

      aside.detail-sidebar
        .panel
          h2 Interacciones
          if sessionUser
            .stack-actions
              if currentUserInterest
                form(action=`/interests/${post.id}/delete` method="POST")
                  button.button.button--soft(type="submit") Quitar de intereses
              else
                form(action="/interests" method="POST")
                  input(type="hidden" name="post_id" value=post.id)
                  button.button.button--soft(type="submit") Guardar en intereses

              if userCollections && userCollections.length
                form.form-grid(action=`/collections/${userCollections[0].id}/items` method="POST")
                  input(type="hidden" name="post_id" value=post.id)
                  .form-field
                    label(for="collection_id") Guardar en colección
                    select#collection_id.form-select(name="collection_id" onchange="this.form.action='/collections/' + this.value + '/items'")
                      each collection in userCollections
                        option(value=collection.id)= collection.name
                  button.button.button--ghost(type="submit") Agregar
              else
                p.text-muted No tienes colecciones creadas todavía.
                a.button.button--ghost(href="/collections/create") Crear colección

            .panel.page-section
              h3 Valoración
              if currentUserOwnsPost
                p.text-muted No puedes valorar tu propia publicación.
              else if ratingSummary && ratingSummary.currentUserRating
                p.text-muted= `Ya valoraste esta publicación con ${ratingSummary.currentUserRating.points} / 5.`
              else
                p.text-muted Todavía no valoraste esta publicación.
                form.form-grid(action=`/posts/${post.id}/ratings` method="POST")
                  .form-field
                    label(for="points") Puntaje
                    select#points.form-select(name="points" required)
                      option(value="1") 1
                      option(value="2") 2
                      option(value="3") 3
                      option(value="4") 4
                      option(value="5") 5
                  button.button.button--dark(type="submit") Guardar valoración

            .panel
              h3 Denunciar publicación
              if currentUserOwnsPost
                p.text-muted No puedes denunciar tu propia publicación.
              else if !currentUserCanReport
                p.text-muted Ya registraste una denuncia activa sobre esta publicación.
              else
                form.form-grid(action=`/posts/${post.id}/reports` method="POST")
                  .form-field
                    label(for="reason") Motivo
                    input#reason.form-input(type="text" name="reason" maxlength="100" required)
                  .form-field
                    label(for="description") Descripción
                    textarea#description.form-textarea(name="description")
                  button.button.button--ghost(type="submit") Enviar denuncia
          else
            p.text-muted Iniciá sesión para valorar, denunciar, guardar intereses o agregar esta publicación a una colección.
            .inline-actions
              a.button.button--dark(href="/auth/login") Iniciar sesión
              a.button.button--ghost(href="/auth/register") Crear cuenta

    section.page-section.grid.grid--two
      .panel
        h2 Comentarios
        if post.comments && post.comments.length
          .comment-list
            each comment in post.comments
              article.comment-item
                strong= comment.user ? comment.user.username : "Usuario"
                p.text-muted= comment.content
        else
          .empty-state
            p No hay comentarios registrados por el momento.

      .panel
        h2 Participar
        if sessionUser && post.comments_enabled
          form.form-grid(action=`/posts/${post.id}/comments` method="POST")
            .form-field
              label(for="content") Comentario
              textarea#content.form-textarea(name="content" required)
            button.button.button--dark(type="submit") Publicar comentario
        else if sessionUser
          p.text-muted Los comentarios están deshabilitados para esta publicación.
        else
          p.text-muted Necesitás iniciar sesión para comentar.
          a.button.button--dark(href="/auth/login") Iniciar sesión
  else
    .empty-state
      h1 Publicación no encontrada
      p.text-muted No existe una publicación registrada con el identificador solicitado.
      a.button.button--ghost(href="/posts") Volver al listado
