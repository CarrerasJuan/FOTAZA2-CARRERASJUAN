doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
  body
    if post
      article
        h1= post.title
        p Autor: #{post.user ? post.user.username : "Sin usuario"}

        if post.user && post.user.biography
          p Biografía del autor: #{post.user.biography}

        if post.description
          p= post.description

        p Estado: #{post.status}
        p Comentarios habilitados: #{post.comments_enabled ? "Sí" : "No"}
        p Fecha de creación: #{post.created_at}
        p
          a(href=`/users/${post.user_id}`) Ver perfil del autor
        p Valoraciones registradas: #{ratingSummary && ratingSummary.total ? ratingSummary.total : 0}
        p Promedio de valoración: #{ratingSummary && ratingSummary.average ? ratingSummary.average : "Sin valoraciones"}
        p Denuncias registradas: #{typeof totalReports === "number" ? totalReports : 0}

        if post.media && post.media.length
          h2 Recursos multimedia
          ul
            each item in post.media
              li
                | #{item.type} - #{item.url}
                |  - Licencia: #{item.license}
                if item.type === "image"
                  div
                    img(src=item.url alt=post.title width="320")

        if post.comments && post.comments.length
          h2 Comentarios
          ul
            each comment in post.comments
              li
                strong= comment.user ? comment.user.username : "Usuario"
                | : #{comment.content}
        else
          h2 Comentarios
          p No hay comentarios registrados por el momento.

        if sessionUser
          h2 Interés
          if currentUserInterest
            p Esta publicación ya se encuentra en tus intereses.
            form(action=`/interests/${post.id}/delete` method="POST")
              button(type="submit") Quitar de intereses
          else
            p Puedes guardar esta publicación como interés.
            form(action="/interests" method="POST")
              input(type="hidden" name="post_id" value=post.id)
              button(type="submit") Guardar en intereses

          if userCollections && userCollections.length
            h2 Guardar en colección
            form(action=`/collections/${userCollections[0].id}/items` method="POST")
              div
                label(for="collection_id") Colección
                select#collection_id(name="collection_id" onchange="this.form.action='/collections/' + this.value + '/items'")
                  each collection in userCollections
                    option(value=collection.id)= collection.name
              input(type="hidden" name="post_id" value=post.id)
              button(type="submit") Agregar a colección
          else
            h2 Guardar en colección
            p No tienes colecciones creadas todavía.
            p
              a(href="/collections/create") Crear primera colección

          h2 Valoración
          if ratingSummary && ratingSummary.currentUserRating
            p Tu valoración actual: #{ratingSummary.currentUserRating.points} / 5
          else
            p Todavía no valoraste esta publicación.

          form(action=`/posts/${post.id}/ratings` method="POST")
            div
              label(for="points") Puntaje
              select#points(name="points" required)
                option(value="1" selected=ratingSummary && ratingSummary.currentUserRating && ratingSummary.currentUserRating.points === 1) 1
                option(value="2" selected=ratingSummary && ratingSummary.currentUserRating && ratingSummary.currentUserRating.points === 2) 2
                option(value="3" selected=ratingSummary && ratingSummary.currentUserRating && ratingSummary.currentUserRating.points === 3) 3
                option(value="4" selected=ratingSummary && ratingSummary.currentUserRating && ratingSummary.currentUserRating.points === 4) 4
                option(value="5" selected=ratingSummary && ratingSummary.currentUserRating && ratingSummary.currentUserRating.points === 5) 5

            button(type="submit") Guardar valoración

          h2 Denunciar publicación
          form(action=`/posts/${post.id}/reports` method="POST")
            div
              label(for="reason") Motivo
              input#reason(type="text" name="reason" maxlength="100" required)

            div
              label(for="description") Descripción
              textarea#description(name="description")

            button(type="submit") Enviar denuncia

        if sessionUser && post.comments_enabled
          h3 Agregar comentario
          form(action=`/posts/${post.id}/comments` method="POST")
            div
              label(for="content") Comentario
              textarea#content(name="content" required)

            button(type="submit") Publicar comentario

        if sessionUser && post.user && sessionUser.id === post.user.id
          p
            a(href=`/posts/${post.id}/edit`) Editar publicación

          form(action=`/posts/${post.id}/delete` method="POST")
            button(type="submit") Eliminar publicación

        p
          a(href="/posts") Volver al listado
        p
          a(href=`/search?q=${encodeURIComponent(post.title)}`) Buscar contenido relacionado
    else
      h1 Publicación no encontrada
      p No existe una publicación registrada con el identificador solicitado.
      p
        a(href="/posts") Volver al listado
