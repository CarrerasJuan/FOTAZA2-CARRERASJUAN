extends ../layouts/main

block content
  section.page-section.form-shell
    .panel
      span.section-eyebrow Nueva publicación
      h1 Crear publicación
      p.section-description Completá el formulario para publicar una entrada con título, descripción, imagen por URL y tags.

      if error
        .alert= error

      form.form-grid(action="/posts" method="POST")
        .form-field
          label(for="title") Título
          input#title.form-input(type="text" name="title" required value=values.title)

        .form-field
          label(for="description") Descripción
          textarea#description.form-textarea(name="description")= values.description

        .form-field
          label(for="media_url") URL de imagen
          input#media_url.form-input(type="url" name="media_url" value=values.media_url)

        .form-field
          label(for="license_option") Licencia
          select#license_option.form-select(name="license_option")
            option(value="standard" selected=values.license_option === "standard") Standard
            option(value="copyright" selected=values.license_option === "copyright") Copyright
            option(value="cc-by" selected=values.license_option === "cc-by") CC BY
            option(value="cc-by-nc" selected=values.license_option === "cc-by-nc") CC BY-NC
            option(value="public-domain" selected=values.license_option === "public-domain") Dominio público

        .form-field
          label(for="license_custom") Licencia personalizada
          input#license_custom.form-input(type="text" name="license_custom" maxlength="30" value=values.license_custom placeholder="Opcional, reemplaza la licencia elegida")

        .form-field
          label(for="watermark_text") Marca de agua mínima
          input#watermark_text.form-input(type="text" name="watermark_text" maxlength="100" value=values.watermark_text placeholder="Opcional, visible sobre la imagen")

        .form-field
          label(for="tags") Tags
          input#tags.form-input(type="text" name="tags" value=values.tags placeholder="paisaje, noche, urbano")

        label.form-checkbox(for="comments_enabled")
          input#comments_enabled(type="checkbox" name="comments_enabled" checked=values.comments_enabled)
          span Permitir comentarios

        .inline-actions
          button.button.button--dark(type="submit") Crear publicación
          a.button.button--ghost(href="/posts") Volver al listado
