extends ../layouts/main

block content
  section.page-section.form-shell
    .panel
      span.section-eyebrow Gestión de contenido
      h1 Editar publicación
      p.section-description Ajustá título, descripción, media, tags y estado de comentarios de tu publicación.

      if error
        .alert= error

      form.form-grid(action=`/posts/${post.id}/edit` method="POST")
        .form-field
          label(for="title") Título
          input#title.form-input(type="text" name="title" required value=values.title)

        .form-field
          label(for="description") Descripción
          textarea#description.form-textarea(name="description")= values.description

        .form-field
          label(for="media_url") URL de imagen
          input#media_url.form-input(type="url" name="media_url" value=values.media_url)

        .form-field
          label(for="tags") Tags
          input#tags.form-input(type="text" name="tags" value=values.tags placeholder="paisaje, noche, urbano")

        label.form-checkbox(for="comments_enabled")
          input#comments_enabled(type="checkbox" name="comments_enabled" checked=values.comments_enabled)
          span Permitir comentarios

        .inline-actions
          button.button.button--dark(type="submit") Guardar cambios
          a.button.button--ghost(href=`/posts/${post.id}`) Volver al detalle
