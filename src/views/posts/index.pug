doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1 Publicaciones
    if sessionUser
      p
        a(href=`/users/${sessionUser.id}`) Ver mi perfil
      p
        a(href="/notifications") Ver notificaciones
      form(action="/auth/logout" method="POST")
        button(type="submit") Cerrar sesión
    else
      p
        a(href="/auth/login") Iniciar sesión
      p
        a(href="/auth/register") Crear cuenta
    if currentTag
      p Filtrando por tag: #{currentTag.name}
      p
        a(href="/posts") Ver todas las publicaciones

    if posts.length
      each post in posts
        article
          h2= post.title
          p Autor: #{post.user ? post.user.username : "Sin usuario"}

          if post.description
            p= post.description

          p Estado: #{post.status}
          p Comentarios habilitados: #{post.comments_enabled ? "Sí" : "No"}
          p Valoraciones: #{post.ratings && post.ratings.length ? post.ratings.length : 0}

          if post.tags && post.tags.length
            p
              | Tags:
              each tag, index in post.tags
                | 
                a(href=`/posts/tags/${tag.id}`)= tag.name
                if index < post.tags.length - 1
                  | ,

          p
            a(href=`/posts/${post.id}`) Ver detalle

          if post.media && post.media.length
            h3 Recursos multimedia
            ul
              each item in post.media
                li
                  | #{item.type} - #{item.url}
                  if item.type === "image"
                    div
                      img(src=item.url alt=post.title width="240")
    else
      p No hay publicaciones registradas por el momento.
