extends ../layouts/main

block content
  .auth-shell
    .auth-card
      span.section-eyebrow Acceso
      h1 Iniciar sesión
      p.section-description Ingresá con tu cuenta para publicar, comentar, valorar y administrar tu perfil.

      if error
        .alert= error

      form.form-grid(action="/auth/login" method="POST")
        .form-field
          label(for="email") Correo electrónico
          input#email.form-input(type="email" name="email" required value=values.email)

        .form-field
          label(for="password") Contraseña
          input#password.form-input(type="password" name="password" required)

        button.button.button--dark(type="submit") Ingresar

      .footer-link-row
        if registrationEnabled
          a.button.button--ghost(href="/auth/register") Crear cuenta
        a.button.button--soft(href="/posts") Explorar publicaciones