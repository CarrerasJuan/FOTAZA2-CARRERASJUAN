extends ../layouts/main

block content
  - const notificationLabels = { comment: "Comentario", rating: "Valoración", follow: "Nuevo seguidor", report: "Denuncia", interest: "Interés" }
  section.page-section
    .panel
      span.section-eyebrow Actividad reciente
      h1 Notificaciones
      p.section-description Revisá interacciones recientes sobre tus publicaciones, tu perfil y otros módulos sociales.

  section.page-section
    if notifications.length
      .notice-list
        each notification in notifications
          article.notice-item
            .notice-card__body
              h2.feed-card__title= notificationLabels[notification.type] || notification.type
              .feed-meta
                span= notification.is_read ? "Leída" : "No leída"
                span= new Date(notification.created_at).toLocaleString("es-AR")
                if notification.actor
                  span= `Usuario: ${notification.actor.username}`

              if notification.type === "comment" && notification.notificationComment && notification.notificationComment.comment
                p.text-muted= notification.notificationComment.comment.content
                .inline-actions
                  a.button.button--ghost.button--small(href=`/posts/${notification.notificationComment.comment.post_id}`) Ver publicación

              if notification.type === "rating" && notification.notificationRating && notification.notificationRating.rating
                p.text-muted= `Puntaje registrado: ${notification.notificationRating.rating.points}`
                .inline-actions
                  a.button.button--ghost.button--small(href=`/posts/${notification.notificationRating.rating.post_id}`) Ver publicación

              if notification.type === "follow" && notification.notificationFollow && notification.notificationFollow.follower
                p.text-muted= `Nuevo seguidor: ${notification.notificationFollow.follower.username}`
                .inline-actions
                  a.button.button--ghost.button--small(href=`/users/${notification.notificationFollow.follower.id}`) Ver perfil

              if notification.type === "report" && notification.notificationReport && notification.notificationReport.report
                p.text-muted= `Motivo: ${notification.notificationReport.report.reason}`
                if notification.notificationReport.report.post_id
                  .inline-actions
                    a.button.button--ghost.button--small(href=`/posts/${notification.notificationReport.report.post_id}`) Ver publicación

              if notification.type === "interest" && notification.notificationInterest && notification.notificationInterest.interest
                p.text-muted
                  if notification.actor
                    | #{notification.actor.username} está interesado en tu publicación.
                  else
                    | Un usuario está interesado en tu publicación.
                if notification.notificationInterest.interest.post
                  p.text-muted= `Publicación: ${notification.notificationInterest.interest.post.title}`
                .inline-actions
                  if notification.actor
                    a.button.button--ghost.button--small(href=`/users/${notification.actor.id}`) Ver perfil
                  if notification.notificationInterest.interest.post_id
                    a.button.button--ghost.button--small(href=`/posts/${notification.notificationInterest.interest.post_id}`) Ver publicación

              unless notification.is_read
                form(action=`/notifications/${notification.id}/read` method="POST")
                  button.button.button--soft.button--small(type="submit") Marcar como leída
    else
      .empty-state
        h2 No hay notificaciones registradas
        p.text-muted Cuando existan interacciones nuevas, aparecerán en este módulo.
